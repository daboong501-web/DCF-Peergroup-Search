# ─── 토스증권 Open API ───
# 발급: 토스증권 PC 웹(https://tossinvest.com) 로그인 → 설정 → Open API
#   * 모바일 앱이 아니라 PC 웹에서 발급합니다.
#   * client_secret 은 발급 화면을 벗어나면 다시 볼 수 없습니다. 그 자리에서 복사하세요.
#   * 같은 화면의 [허용 IP 관리] 에 호출할 머신의 공인 IP 를 반드시 등록하세요.
#     미등록 IP 는 키가 맞아도 403 으로 차단됩니다. (curl -s https://ifconfig.me 로 확인)
TOSS_CLIENT_ID=
TOSS_CLIENT_SECRET=

# 계좌 식별자. 주문/잔고 API 의 X-Tossinvest-Account 헤더에 들어갑니다.
# 값을 모르면 비워두고 `npx tsx scripts/verify-toss.ts` 를 돌리면 알려줍니다.
TOSS_ACCOUNT_SEQ=

# 선택: API 베이스 URL 오버라이드 (기본 https://openapi.tossinvest.com)
# TOSS_API_BASE=

# 선택: verify-toss.ts 가 캔들 검사에 쓸 종목 (기본 AAPL)
# VERIFY_SYMBOL=AAPL

# ─── 기존 기능용 ───
# OpenDART (dart_* 및 valuation_get_data 툴)
OPENDART_API_KEY=
